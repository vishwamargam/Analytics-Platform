NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/analytics_platform
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
INTERNAL_INGESTION_KEY=replace-with-a-random-server-only-key-at-least-16-characters
ANALYTICS_INGESTION_ENDPOINT=http://localhost:3000/api/events
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
ORDER_CURRENCY=USD
# Set to 1 only when running behind a trusted reverse proxy.
TRUST_PROXY=0
